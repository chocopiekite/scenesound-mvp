# 실제 키는 .env.local에만 입력하세요. 이 예제 파일에 입력하지 마세요.
TWELVELABS_API_KEY=
TWELVELABS_MODEL=pegasus1.6

# Freesound 검색 키: 서버에만 설정하며 HTML에 넣지 마세요.
FREESOUND_API_KEY=

# Supabase 전송 함수에도 같은 비밀 값을 설정 (브라우저 공개 금지)
VIDEO_UPLOAD_RELAY_SECRET=

# Epidemic Sound Free 키는 로컬 시제품 시험용입니다. Vercel에는 설정하지 마세요.
# macOS에서는 npm run dev가 scenesound-mvp-epidemic-test 키체인 항목을 사용합니다.
# 다른 환경에서는 서버 프로세스의 환경 변수로만 전달하세요.
EPIDEMIC_API_KEY=
